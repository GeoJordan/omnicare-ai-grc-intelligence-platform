{
  "name": "@servicenow/sdk-build-core",
  "version": "4.8.1",
  "description": "ServiceNow SDK Build System Core Libraries",
  "license": "MIT",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "src",
    "now.config.schema.json"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./telemetry": {
      "types": "./dist/telemetry/index.d.ts",
      "default": "./dist/telemetry/index.js"
    }
  },
  "dependencies": {
    "ci-info": "4.4.0",
    "fast-glob": "3.3.3",
    "fflate": "0.8.2",
    "json5": "2.2.3",
    "jsonschema": "1.5.0",
    "lodash": "4.18.1",
    "pathe": "1.1.2",
    "prettier": "3.6.1",
    "readable-stream": "4.5.2",
    "ts-morph": "24.0.0",
    "vscode-languageserver": "9.0.1",
    "xml-js": "1.6.11",
    "xmlbuilder2": "4.0.3",
    "zod": "3.23.8",
    "@servicenow/sdk-core": "4.8.1"
  },
  "overrides": {
    "micromatch": "4.0.7"
  },
  "devDependencies": {
    "@types/lodash": "4.17.23",
    "@types/readable-stream": "4.0.15"
  },
  "engines": {
    "node": ">=20.18.0",
    "pnpm": ">=10.8.0"
  },
  "scripts": {
    "build": "tsc -b && tsx esbuild.config.ts",
    "build:production": "tsc -b && tsx esbuild.config.ts",
    "bundle": "tsc -b && tsx esbuild.config.ts",
    "bundle:production": "tsc -b && tsx esbuild.config.ts",
    "clean": "tsc -b --clean",
    "watch": "tsc -b -w",
    "test": "export NODE_OPTIONS=\"--max-old-space-size=8192 --experimental-vm-modules\" && jest --colors --no-cache --logHeapUsage"
  }
}